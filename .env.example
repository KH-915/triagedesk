# ────────────────────────────────────────────────────────────
# TriageDesk — Environment variable template
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets to source control.
# ────────────────────────────────────────────────────────────

# Application
NODE_ENV=development
PORT=4000

# Database (matches the docker-compose.yml defaults)
DATABASE_URL=postgresql://triagedesk:triagedesk@localhost:5432/triagedesk

# Authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_random_64_char_hex_string_never_commit_real_secrets
JWT_EXPIRES_IN=24h

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=3000

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Test database — used by Jest integration tests (must be a separate DB)
TEST_DATABASE_URL=postgresql://triagedesk:triagedesk@localhost:5432/triagedesk_test
